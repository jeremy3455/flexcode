# Opcion 1: Ollama (local, gratis) - no necesita API key
# Instala Ollama: https://ollama.com
# ollama pull llama3.2
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# Opcion 2: OpenAI (requiere API key)
# OPENAI_API_KEY=sk-tu-api-key
# OPENAI_MODEL=gpt-4o-mini

# Opcion 3: Groq (gratis, requiere registro en groq.com)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_tu-api-key-groq
# OPENAI_MODEL=llama3-70b-8192

# Opcion 4: Gemini (via API key de Google Cloud)
# Google expone un endpoint compatible con OpenAI, funciona con el mismo cliente.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIza...  o  AQ....
# OPENAI_MODEL=gemini-1.5-pro
